{
  "manifest_version": 3,
  "name": "Price Helper for iHerb",
  "version": "1.1.0",
  "description": "Extension that calculates and displays unit price badges for pill like iHerb products.",
  "homepage_url": "https://mklimp.com/phiherb/",
  "developer": {
    "name": "Mark Klimp"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "price-helper-for-iherb@mklimp.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "preferences/preferences.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["*://www.iherb.com/*"],
      "js": [
        "shared/product-matching.js",
        "shared/badge-size.js",
        "content/content.js"
      ],
      "css": ["styles/inject.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["config.json"],
      "matches": ["*://www.iherb.com/*"]
    }
  ]
}
